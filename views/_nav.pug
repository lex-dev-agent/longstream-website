//- Standard site header / top navbar — shared across every page.
header.v5-header
  .wrap
    a.v5-brand(href="/")
      img(src="/images/logo-white.png", alt="Longstream Distillery")
      span LONGSTREAM
    button.v5-navtoggle(type="button", aria-label="Menu", aria-expanded="false", aria-controls="v5-nav")
      span.v5-navtoggle-bar
      span.v5-navtoggle-bar
      span.v5-navtoggle-bar
    nav.v5-nav#v5-nav
      a(href="/#range") Products
      a(href="/#story") Our Story
      a(href="/contact") Contact
      //- The club signup only exists on the landing page, so this is always a
      //- cross-page link. From the landing page itself it is a fragment-only
      //- change, so the browser scrolls rather than reloading.
      a.v5-btn.v5-btn-alt(href="/#club") Club
      a.v5-btn(href="/order") Order

script.
  (function () {
    var toggle = document.querySelector('.v5-navtoggle');
    var nav = document.getElementById('v5-nav');
    if (!toggle || !nav) return;
    function setOpen(open) {
      nav.classList.toggle('is-open', open);
      toggle.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    toggle.addEventListener('click', function () {
      setOpen(!nav.classList.contains('is-open'));
    });
    // Close after tapping a link, or when tapping outside the menu
    nav.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
    document.addEventListener('click', function (e) {
      if (!nav.contains(e.target) && !toggle.contains(e.target)) setOpen(false);
    });
  })();
