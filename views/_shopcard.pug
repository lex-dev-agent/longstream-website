//- Shopping-style product card (products page). Clicking the card opens the
//- shared detail modal; the Order button links straight to /order. It carries
//- the same hidden .v5-card-data payload the modal clones. Include _spiritmodal
//- on the page for the modal behaviour.
mixin shopCard(s)
  - var available = s.status === 'available'
  .v5-card.shop-card(role="button", tabindex="0", data-spirit=s.id, data-status=s.status, class={"v5-card-out": !available})
    if s.status === 'soldout'
      span.v5-badge Sold out
    else if s.status === 'coming-soon'
      span.v5-badge Coming soon
    img.v5-card-bottle(src="/images/v3-bottle-new.png", onerror="this.src='/images/bottle.webp'", alt=`${s.name} bottle`)
    h3.shop-name= s.name
    p.shop-meta #{s.volume} · #{s.abv}
    .shop-foot
      if available
        p.shop-price NZ$#{s.price}
        a.shop-order.v5-btn-solid(href="/order", onclick="event.stopPropagation()") Order
      else
        span.shop-order-out= s.status === 'soldout' ? 'Sold out' : 'Coming soon'
    template.v5-card-data
      .v5-modal-story-content
        h2= s.name
        if s.story
          each para in s.story
            p= para
      .v5-modal-aside-content
        if s.bestServed && s.bestServed.length
          p.v5-kicker Best served
          ul.v5-served
            each item in s.bestServed
              li= item
        if s.photo
          figure.v5-detail-photo
            img(src=`/images/v5-${s.id}.jpg`, alt=s.photoAlt, onerror="this.style.display='none'; this.parentNode.classList.add('is-empty')")
            figcaption Photo coming soon
