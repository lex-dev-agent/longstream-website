//- Spirit card — opens the standardised modal on click. Carries a hidden
//- payload (story + best served) the modal clones into its middle/right columns.
//- Include this before using +spiritCard, and include _spiritmodal once on the page.
mixin spiritCard(s)
  //- Per-spirit bottle shot comes from the product data (src/server.js);
  //- anything without one falls back to the generic render. Serve the webp
  //- (npm run images) and let onerror drop back to the png on old browsers.
  - var bottlePng = s.bottle || '/images/v3-bottle-new.png'
  - var bottleImg = s.bottle ? s.bottle.replace(/\.png$/, '.webp') : bottlePng
  a.v5-card(href="#", role="button", data-spirit=s.id, data-status=s.status, class={"v5-card-out": s.status !== 'available'})
    if s.status === 'soldout'
      span.v5-badge Sold out
    else if s.status === 'coming-soon'
      span.v5-badge Coming soon
    img.v5-card-bottle(src=bottleImg, onerror=`this.onerror=null;this.src='${bottlePng}'`, alt=`${s.name} bottle`)
    h3= s.name
    p= s.description
    if s.serve
      p.v5-card-serve= s.serve
    .v5-card-foot
      p.v5-card-meta
        | #{s.volume} · #{s.abv}
        if s.status === 'available'
          |  · NZ$#{s.price}
        else if s.status === 'soldout'
          |  · Sold out
        else if s.status === 'coming-soon'
          |  · NZ$-
      //- Affordance only — the whole card is the modal trigger, so this is a
      //- span (an anchor can't nest inside the card's anchor).
      span.v5-card-more Read more →
    template.v5-card-data
      .v5-modal-story-content
        h2= s.name
        if s.story
          each para in s.story
            p= para
        //- Blonde-named spirits all carry the same label portrait, so they all
        //- link out to the story behind it. Safe to nest an anchor here: the
        //- parser puts <template> content in its own fragment, outside the
        //- card's own anchor.
        if s.blondeStory
          a.v5-story-link(href="/blonde")
            img.v5-story-link-thumb(src="/images/blonde-girl/label.webp", onerror="this.onerror=null;this.src='/images/blonde-girl/label.jpg'", alt="", width="368", height="343", loading="lazy")
            span.v5-story-link-text
              span.v5-story-link-kicker Behind the label
              span.v5-story-link-title Where the name Blonde came from, and who is on the bottle
            span.v5-story-link-arrow →
      .v5-modal-aside-content
        if s.bestServed && s.bestServed.length
          p.v5-kicker Best served
          ul.v5-served
            each item in s.bestServed
              li= item
        if s.photo
          //- No <img> unless the file exists — see detailPhoto() in server.js.
          figure.v5-detail-photo(class={"is-empty": !s.photoSrc})
            if s.photoSrc
              img(src=s.photoSrc, alt=s.photoAlt)
            figcaption Photo coming soon
