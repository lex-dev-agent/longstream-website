//- Floating switcher shown on every variation page.
//- Expects a `current` local ('v0' | 'v1' | 'v2' | 'v3' | 'v4' | 'v5') from the route.
.vswitch
  a(href="/v0", class={active: current === 'v0'}) V0
  a(href="/v1", class={active: current === 'v1'}) V1
  a(href="/v2", class={active: current === 'v2'}) V2
  a(href="/v3", class={active: current === 'v3'}) V3
  a(href="/v4", class={active: current === 'v4'}) V4
  a(href="/v5", class={active: current === 'v5'}) V5
  a.vswitch-age(href="#", onclick="lsShowAgeGate();return false;", title="Show the 18+ age check") 18+
style.
  .vswitch-age { border: 1px solid #c9a85c; color: #c9a85c !important; margin-left: 0.3rem; }
  .vswitch-age:hover { background: #c9a85c; color: #111 !important; }
