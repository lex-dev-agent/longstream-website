extends layout-design

block fab

mixin cardFrontContent
  .bc-front-accent
  .bc-front-body
    img.bc-logo(src="/images/logo-white.png" alt="Longstream Distillery" width="48" height="48")
    .bc-front-text
      p.bc-company Longstream Distillery
      h4.bc-name Ross Remnant
      p.bc-title Founder &amp; Distiller
    .bc-front-tagline Small-batch gin with Aotearoa spirit

mixin cardBackContent
  .bc-back-header
    img.bc-logo(src="/images/logo-white.png" alt="Longstream Distillery" width="36" height="36")
    span.bc-back-brand Longstream Distillery
  .bc-back-details
    .bc-detail-row
      span.bc-detail-label Phone
      span.bc-detail-value 021 123 4567
    .bc-detail-row
      span.bc-detail-label Web
      span.bc-detail-value longstream.nz
    .bc-detail-row
      span.bc-detail-label Email
      a.bc-detail-value(href="mailto:enquiries@longstream.nz") enquiries@longstream.nz
  .bc-back-footer Crafted in the Wellington Region with pride

mixin ginLabelContent
  .gin-label-inner
    img.label-logo(src="/images/logo-white.png" alt="Longstream Distillery" width="48" height="48")
    p.label-distillery LONGSTREAM DISTILLERY
    .label-gold-rule
    .label-name-block
      h2.label-brand BLONDE
      p.label-type CLASSIC DRY GIN
    .label-botanical-divider
      span.label-botanical-icon ◆
    p.label-origin Mangaroa · Upper Hutt<br>New Zealand
    p.label-tasting Crisp Pine · Warm Spice · Citris Finish
    .label-gold-rule
    .label-footer-specs
      span 700 ml
      span.label-dot ·
      span 38% ABV

mixin ginClassicV2Front(word, tasting, gintype, brand, abv)
  - if (word === undefined) word = 'CLASSIC'
  - tasting = tasting || 'Crisp and Warm Spice · Lime Finish'
  - brand = brand || 'BLONDE'
  - if (gintype === undefined) gintype = 'DRY GIN'
  - abv = abv || '38% ABV'
  .gin-label-inner
    p.label-distillery.clv2-brandline LONGSTREAM #[img.clv2-brandlogo(src="/images/logo-white.png" alt="Longstream Distillery")] DISTILLERY
    .clv2-imgslot(aria-hidden="true")
    .label-name-block
      if word
        p.clv2-classic= word
      h2.label-brand= brand
      if gintype
        .label-botanical-divider
          span.clv2-drygin= gintype
    p.label-origin Mangaroa · Upper Hutt<br>New Zealand
    p.label-tasting= tasting
    .label-gold-rule
    .label-footer-specs
      span 700 ml
      span.label-dot ·
      span= abv

mixin ginBackLabelContent
