          h3.label-section-label Front
          .gin-label.gl-frame#glv4-front
            +ginFrameFront
        .label-card-wrapper
          h3.label-section-label Back
          .gin-label.gin-label-back.gl-frame#glv4-back
            +ginBackLabelContent

      .label-download
        .label-download-actions
          button.button.button-primary#glv4-pdf(type="button") Download Print-Ready PDF
          button.button.button-secondary.label-btn-png#glv4-png(type="button") Download PNG
        p.label-download-note
          | PDF includes bleed &amp; crop marks at 300 DPI.
          br
          | PNG downloads the label as shown above.

  .label-print-offscreen(aria-hidden="true")
    .gin-label.gin-label--print.gl-frame#glv4-print-front
      +ginFrameFront
    .gin-label.gin-label-back.gin-label--print.gl-frame#glv4-print-back
      +ginBackLabelContent

  script.
    (function () {
      var TRIM_W = 3.5, TRIM_H = 4.875, BLEED = 0.125;
      var PAGE_W = TRIM_W + BLEED * 2, PAGE_H = TRIM_H + BLEED * 2, DPI = 300;
      var MARK_LEN = 0.08, MARK_GAP = 0.02;

      function capture(el, w, h) {
        var r = el.getBoundingClientRect();
        var s = Math.max(w / r.width, h / r.height);
        return html2canvas(el, { scale: s, useCORS: true, backgroundColor: null, width: r.width, height: r.height, windowWidth: document.documentElement.scrollWidth });
      }
      function marks(pdf) {
        pdf.setDrawColor(0); pdf.setLineWidth(0.003);
        var l = BLEED, t = BLEED, rt = BLEED + TRIM_W, b = BLEED + TRIM_H;
        [[l, t, -1, -1], [rt, t, 1, -1], [l, b, -1, 1], [rt, b, 1, 1]].forEach(function (c) {
          pdf.line(c[0] + c[2] * MARK_GAP, c[1], c[0] + c[2] * (MARK_GAP + MARK_LEN), c[1]);
          pdf.line(c[0], c[1] + c[3] * MARK_GAP, c[0], c[1] + c[3] * (MARK_GAP + MARK_LEN));
        });
      }
      function loading(btn, on) {
        if (on) { btn.dataset.o = btn.textContent; btn.textContent = 'Generating…'; btn.disabled = true; }
        else { btn.textContent = btn.dataset.o; btn.disabled = false; }
      }
      function dl(url, name) {
        var a = document.createElement('a'); a.href = url; a.download = name;
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
      }
      function init(id, file) {
        var pdfBtn = document.getElementById(id + '-pdf');
        var pngBtn = document.getElementById(id + '-png');
        if (!pdfBtn || !pngBtn) return;
        pdfBtn.addEventListener('click', function () {
          loading(pdfBtn, true);
          Promise.all([
            capture(document.getElementById(id + '-print-front'), PAGE_W * DPI, PAGE_H * DPI),
            capture(document.getElementById(id + '-print-back'), PAGE_W * DPI, PAGE_H * DPI)
          ]).then(function (cv) {
            var jsPDF = window.jspdf.jsPDF;
            var pdf = new jsPDF({ orientation: 'portrait', unit: 'in', format: [PAGE_W, PAGE_H] });
            cv.forEach(function (c, i) {
              if (i > 0) pdf.addPage([PAGE_W, PAGE_H], 'portrait');
              pdf.addImage(c.toDataURL('image/png'), 'PNG', 0, 0, PAGE_W, PAGE_H);
              marks(pdf);
            });
            pdf.save(file + '.pdf');
          }).catch(function (e) { console.error(e); alert('Something went wrong generating the PDF. Please try again.'); })
            .finally(function () { loading(pdfBtn, false); });
        });
        pngBtn.addEventListener('click', function () {
          loading(pngBtn, true);
          Promise.all([
            capture(document.getElementById(id + '-front'), TRIM_W * DPI, TRIM_H * DPI),
            capture(document.getElementById(id + '-back'), TRIM_W * DPI, TRIM_H * DPI)
          ]).then(function (cv) {
            dl(cv[0].toDataURL('image/png'), file + '-front.png');
            setTimeout(function () { dl(cv[1].toDataURL('image/png'), file + '-back.png'); }, 300);
          }).catch(function (e) { console.error(e); alert('Something went wrong generating the PNG. Please try again.'); })
            .finally(function () { loading(pngBtn, false); });
        });
      }
      init('glv1', 'blonde-gin-classic');
      init('glv2', 'blonde-gin-modern');
      init('glv3', 'blonde-gin-band');
      init('glv4', 'blonde-gin-frame');
      init('glv5', 'blonde-gin-classic-v2');
      init('glv6', 'blonde-gin-classic-v3');
      init('glv7', 'blonde-gin-classic-v4');
      init('glv8', 'blonde-gin-blushing');
      init('glv9', 'blonde-gin-zesty');
      init('glv10', 'seeking-vodka');
      init('glv11', 'louies-limoncello');
      init('glv12', 'maymorn-estate-gin');
    })();
