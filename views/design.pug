  script.
    (function () {
      var TRIM_W = 3.5, TRIM_H = 4.875, BLEED = 0.125;
      var PAGE_W = TRIM_W + BLEED * 2, PAGE_H = TRIM_H + BLEED * 2, DPI = 300;
      var MARK_LEN = 0.08, MARK_GAP = 0.02;

      function capture(el, w, h) {
        var r = el.getBoundingClientRect();
        var s = Math.max(w / r.width, h / r.height);
        return html2canvas(el, { scale: s, useCORS: true, backgroundColor: null, width: r.width, height: r.height, windowWidth: document.documentElement.scrollWidth });
      }
      function marks(pdf) {
        pdf.setDrawColor(0); pdf.setLineWidth(0.003);
        var l = BLEED, t = BLEED, rt = BLEED + TRIM_W, b = BLEED + TRIM_H;
        [[l, t, -1, -1], [rt, t, 1, -1], [l, b, -1, 1], [rt, b, 1, 1]].forEach(function (c) {
          pdf.line(c[0] + c[2] * MARK_GAP, c[1], c[0] + c[2] * (MARK_GAP + MARK_LEN), c[1]);
          pdf.line(c[0], c[1] + c[3] * MARK_GAP, c[0], c[1] + c[3] * (MARK_GAP + MARK_LEN));
        });
      }
      function loading(btn, on) {
        if (on) { btn.dataset.o = btn.textContent; btn.textContent = 'Generating…'; btn.disabled = true; }
        else { btn.textContent = btn.dataset.o; btn.disabled = false; }
      }
      function dl(url, name) {
        var a = document.createElement('a'); a.href = url; a.download = name;
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
      }
      function init(id, file) {
        ['front', 'back'].forEach(function (side) {
          var pdfBtn = document.getElementById(id + '-pdf-' + side);
          var pngBtn = document.getElementById(id + '-png-' + side);
          if (pdfBtn) pdfBtn.addEventListener('click', function () {
            loading(pdfBtn, true);
            capture(document.getElementById(id + '-print-' + side), PAGE_W * DPI, PAGE_H * DPI)
              .then(function (c) {
                var jsPDF = window.jspdf.jsPDF;
                var pdf = new jsPDF({ orientation: 'portrait', unit: 'in', format: [PAGE_W, PAGE_H] });
                pdf.addImage(c.toDataURL('image/png'), 'PNG', 0, 0, PAGE_W, PAGE_H);
                marks(pdf);
                pdf.save(file + '-' + side + '.pdf');
              }).catch(function (e) { console.error(e); alert('Something went wrong generating the PDF. Please try again.'); })
              .finally(function () { loading(pdfBtn, false); });
          });
          if (pngBtn) pngBtn.addEventListener('click', function () {
            loading(pngBtn, true);
            capture(document.getElementById(id + '-' + side), TRIM_W * DPI, TRIM_H * DPI)
              .then(function (c) { dl(c.toDataURL('image/png'), file + '-' + side + '.png'); })
              .catch(function (e) { console.error(e); alert('Something went wrong generating the PNG. Please try again.'); })
              .finally(function () { loading(pngBtn, false); });
          });
        });
      }
      init('glv1', 'blonde-gin-classic');
      init('glv2', 'blonde-gin-modern');
      init('glv3', 'blonde-gin-band');
      init('glv4', 'blonde-gin-frame');
      init('glv7', 'blonde-gin-classic-v4');
      init('glv14', 'blonde-gin-classic-v5');
      init('glv8', 'blonde-gin-blushing');
      init('glv9', 'blonde-gin-zesty');
      init('glv13', 'blonde-gin-coastal');
      init('glv10', 'seeking-vodka');
      init('glv11', 'louies-limoncello');
      init('glv12', 'maymorn-estate-gin');
    })();
