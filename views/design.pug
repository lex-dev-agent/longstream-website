    span.bco-spine-word Longstream
    img.bco-spine-mark(src="/images/logo.png" alt="Longstream Distillery" width="16" height="16")
  .bco-panel-body
    h4.bco-panel-name Ross Remnant
    p.bco-panel-role Founder &amp; Distiller
    .bco-rows
      .bco-row
        span.bco-row-label Phone
        span.bco-row-value 021 174 1439
      .bco-row
        span.bco-row-label Web
        span.bco-row-value longstream.nz
      .bco-row
        span.bco-row-label Email
        a.bco-row-value(href="mailto:rossremnant5@gmail.com") rossremnant5@gmail.com
      .bco-row.bco-row-origin
        span.bco-row-value Est. 2018 · Mangaroa Valley

//- "Stone" — pale uncoated stock with a single gold rule running
//- edge to edge: the long stream. Everything else sits quietly
//- beneath it.
mixin cardOptionStone
  .bco-stone-head
    img.bco-stone-mark(src="/images/logo.png" alt="Longstream Distillery" width="22" height="22")
    span.bco-stone-word Longstream
    span.bco-stone-origin Mangaroa Valley
