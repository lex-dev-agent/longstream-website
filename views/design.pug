      img.bc-logo(src="/images/logo-white.png" alt="Longstream Distillery" width="30" height="30")
      span.bc-back-wordmark LONGSTREAM
  h4.bc-back-name Ross Remnant
  .bc-back-details
    .bc-detail-row
      span.bc-detail-label Phone
      span.bc-detail-value 021 174 1439
    .bc-detail-row
      span.bc-detail-label Web
      span.bc-detail-value longstream.nz
    .bc-detail-row
      span.bc-detail-label Email
      a.bc-detail-value(href="mailto:rossremnant5@gmail.com") rossremnant5@gmail.com
  .bc-back-footer Crafted in the Wellington Region with pride

//- ── Single-sided card options ─────────────────────────────────
//- Three standalone directions. Each carries the mark, the name
//- and every contact on one face, so the reverse can stay blank.

//- "Label" — the card set as one of our bottle labels: keyline
//- frame, centred stack, botanical mark, and the name sitting in
//- the slot BLONDE occupies on the bottle.
mixin cardOptionLabel
  .bco-keyline
  .bco-keyline-inner
  .bco-label-body
    img.bco-mark(src="/images/logo-white.png" alt="Longstream Distillery" width="24" height="24")
    p.bco-label-house Longstream Distillery
    .bco-label-rule
    h4.bco-label-name Ross Remnant
    p.bco-label-role Founder &amp; Distiller
    .bco-botanical
      span.bco-botanical-icon ◆
    p.bco-label-line 021 174 1439 · longstream.nz
    a.bco-label-line.bco-label-email(href="mailto:rossremnant5@gmail.com") rossremnant5@gmail.com

//- "Spec Panel" — the printed panel from the back of a bottle: a
//- solid gold spine carrying the wordmark, then label/value rows
//- ruled and right-aligned like a batch record.
mixin cardOptionPanel
