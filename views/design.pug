mixin ginClassicV2Front(word, tasting, gintype, brand, abv, bg)
  - if (word === undefined) word = 'CLASSIC'
  - tasting = tasting || 'Crisp and Warm Spice · Lime Finish'
  - brand = brand || 'BLONDE'
  - if (gintype === undefined) gintype = 'DRY GIN'
  - abv = abv || '38% ABV'
  //- Optional per-label background art; defaults to the shared Classic photo.
  - bg = bg || '/images/woman-background5.png'
  img.gl-bg(src=bg, alt="", aria-hidden="true")
  .gin-label-inner
    p.label-distillery.clv2-brandline LONGSTREAM #[img.clv2-brandlogo(src="/images/logo-white.png" alt="Longstream Distillery")] DISTILLERY
    .clv2-imgslot(aria-hidden="true")
    .label-name-block
