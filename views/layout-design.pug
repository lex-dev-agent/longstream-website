doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Design — Longstream Distillery
    //- Dark logo by default (shows on light tab bars); white logo in dark mode
    link(rel="icon", type="image/png", href="/images/logo.png")
    link(rel="icon", type="image/png", href="/images/logo-white.png", media="(prefers-color-scheme: dark)")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="crossorigin")
    link(href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400;500&family=EB+Garamond:wght@400;600&family=Manrope:wght@400;600;700&display=swap", rel="stylesheet")
    //- Base collateral geometry (main.css) + new brand system (v5.css) + dark re-skin
    link(rel="stylesheet", href="/styles/main.css")
    link(rel="stylesheet", href="/styles/v5.css")
    link(rel="stylesheet", href="/styles/design-v5.css")

  body.design-v5
    include _nav
    main(role="main")
      block content

    footer.v5-footer
      .wrap
        .v5-foot-brand Longstream Distillery
        p Crafted with passion in Mangaroa, Upper Hutt.
        p © #{new Date().getFullYear()} Longstream Distillery Limited. All rights reserved.

    block fab
