doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Order — Longstream Distillery
    //- Dark logo by default (shows on light tab bars); white logo in dark mode
    link(rel="icon", type="image/png", href="/images/logo.png")
    link(rel="icon", type="image/png", href="/images/logo-white.png", media="(prefers-color-scheme: dark)")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="crossorigin")
    link(href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400;500&display=swap", rel="stylesheet")
    link(rel="stylesheet", href="/styles/v5.css")
    link(rel="stylesheet", href="/styles/order.css")

  body
    include _nav

    //- Order row — available spirits get a quantity stepper; coming soon / sold
    //- out spirits are shown greyed out and can't be ordered.
    mixin orderItem(bottle)
      - var available = bottle.status === 'available'
      .ord-item(class={"ord-item--out": !available}, data-id=bottle.id, data-name=bottle.name, data-price=bottle.price)
        img.ord-item-img(src="/images/v3-bottle-new.png", onerror="this.src='/images/bottle.webp'", alt=`${bottle.name} bottle`)
        .ord-item-body
          h3.ord-item-name= bottle.name
          p.ord-item-desc= bottle.description
          if available
            p.ord-item-meta #{bottle.volume} · #{bottle.abv} · NZ$#{bottle.price}
          else
            p.ord-item-meta #{bottle.volume} · #{bottle.abv}
        if available
          .ord-stepper
            button.ord-step-btn(type="button", data-act="dec", aria-label=`Remove one ${bottle.name}`) −
            input.ord-qty(type="number", min="0", max="12", value="0", readonly, aria-label=`${bottle.name} quantity`)
            button.ord-step-btn(type="button", data-act="inc", aria-label=`Add one ${bottle.name}`) +
        else
          span.ord-item-status= bottle.status === 'soldout' ? 'Sold out' : 'Coming soon'

    main
      //- HERO
      section.ord-hero
        .wrap
          .v5-rule.center
          p.v5-kicker Cellar door
          h1 Order your bottles
          p.ord-lead Choose the Longstream spirits you'd like below, then continue to checkout.

      //- CHOOSER + SUMMARY
      section.ord-main
        .wrap.ord-grid
          .ord-choose
            .ord-section-head
              h2 Signature Range
            each bottle in bottles
              +orderItem(bottle)
            .ord-section-head
              h2 Experimental Range
            each batch in experimentalBatches
              +orderItem(batch)

          aside.ord-summary
            .ord-summary-card
              h2 Your order
              ul.ord-summary-list
                li.ord-summary-empty No bottles selected yet.
              dl.ord-summary-totals
                div
                  dt Subtotal
                  dd#ord-subtotal NZ$0.00
              button.v5-btn-solid.ord-continue(type="button", id="ord-continue", disabled) Checkout
              p.ord-summary-legal You must be 18 or older to purchase.

    include _footer

    //- SECOND 18+ gate — shown at checkout (the site-entry gate is the first)
    .ord-gate(id="ord-gate", hidden)
      .ord-gate-card
        //- Step A: the age question
        div(id="ord-gate-ask")
          p.v5-kicker Mangaroa Valley Small Batch Spirits
          h2.ord-gate-title Are you 18 or older?
          p.ord-gate-text You must be of legal drinking age in New Zealand to purchase alcohol.
          .ord-gate-actions
            button.v5-btn-solid(type="button", id="ord-gate-yes") Yes, I'm 18 or older
            button.v5-btn-ghost(type="button", id="ord-gate-no") No
          p.ord-gate-deny(id="ord-gate-deny", hidden) Sorry — you must be 18 or older to purchase. Please drink responsibly.
        //- Step B: confirmation — not selling online yet
        .ord-gate-done(id="ord-gate-done", hidden)
          p.v5-kicker Thanks for checking us out
          h2.ord-gate-title We're not selling online just yet
          p We're not open for business quite yet. Join the Longstream Club and we'll let you know the moment our spirits go on sale.
          .ord-gate-actions
            a.v5-btn-solid(href="/#club") Join the Club
            button.v5-btn-ghost(type="button", id="ord-gate-close") Keep browsing

    include _agegate

    script.
      (function () {
        var currency = new Intl.NumberFormat('en-NZ', { style: 'currency', currency: 'NZD' });
        var items = Array.prototype.slice.call(document.querySelectorAll('.ord-item:not(.ord-item--out)'));
        var listEl = document.querySelector('.ord-summary-list');
        var subtotalEl = document.getElementById('ord-subtotal');
        var continueBtn = document.getElementById('ord-continue');

        function render() {
          var subtotal = 0, lines = [];
          items.forEach(function (item) {
            var qty = parseInt(item.querySelector('.ord-qty').value, 10) || 0;
            item.classList.toggle('is-picked', qty > 0);
            if (qty > 0) {
              var price = parseFloat(item.dataset.price) || 0;
              subtotal += qty * price;
              lines.push({ name: item.dataset.name, qty: qty, total: qty * price });
            }
          });
          listEl.innerHTML = '';
          if (!lines.length) {
            var empty = document.createElement('li');
            empty.className = 'ord-summary-empty';
            empty.textContent = 'No bottles selected yet.';
            listEl.appendChild(empty);
          } else {
            lines.forEach(function (l) {
              var li = document.createElement('li');
              li.innerHTML = '<span>' + l.qty + ' × ' + l.name + '</span><span>' + currency.format(l.total) + '</span>';
              listEl.appendChild(li);
            });
          }
          subtotalEl.textContent = currency.format(subtotal);
          continueBtn.disabled = !lines.length;
        }

        items.forEach(function (item) {
          var input = item.querySelector('.ord-qty');
          item.querySelectorAll('.ord-step-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
              var qty = parseInt(input.value, 10) || 0;
              qty += btn.dataset.act === 'inc' ? 1 : -1;
              if (qty < 0) qty = 0;
              if (qty > 12) qty = 12;
              input.value = qty;
              render();
            });
          });
        });

        // --- 18+ checkout gate (second gate before purchase) ---
        var gate = document.getElementById('ord-gate');
        var ask = document.getElementById('ord-gate-ask');
        var done = document.getElementById('ord-gate-done');
        var deny = document.getElementById('ord-gate-deny');
        function openGate() {
          ask.hidden = false; done.hidden = true; deny.hidden = true;
          gate.hidden = false; document.body.style.overflow = 'hidden';
        }
        function closeGate() { gate.hidden = true; document.body.style.overflow = ''; }

        continueBtn.addEventListener('click', function () { if (!continueBtn.disabled) openGate(); });
        document.getElementById('ord-gate-yes').addEventListener('click', function () {
          ask.hidden = true; done.hidden = false;
        });
        document.getElementById('ord-gate-no').addEventListener('click', function () { deny.hidden = false; });
        document.getElementById('ord-gate-close').addEventListener('click', closeGate);
        gate.addEventListener('click', function (e) { if (e.target === gate) closeGate(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !gate.hidden) closeGate(); });

        render();
      })();
