doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Products — Longstream Distillery
    //- Dark logo by default (shows on light tab bars); white logo in dark mode
    link(rel="icon", type="image/png", href="/images/logo.png")
    link(rel="icon", type="image/png", href="/images/logo-white.png", media="(prefers-color-scheme: dark)")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="crossorigin")
    //- Shared brand fonts (header/footer/modal) + the catalogue's own faces
    link(href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400;500&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&family=Archivo:wght@400;500;600&family=Spline+Sans+Mono:wght@400;500&display=swap", rel="stylesheet")
    link(rel="stylesheet", href="/styles/v5.css")
    link(rel="stylesheet", href="/styles/products.css")

  body
    include _nav

    //- ---- mixins ----------------------------------------------------------
    //- Signature spirit = a large "specimen" entry (alternating sides)
    mixin specimen(s, i)
      - var available = s.status === 'available'
      - var cat = /gin/i.test(s.name) ? 'Gin' : /limoncello/i.test(s.name) ? 'Limoncello' : /vodka/i.test(s.name) ? 'Vodka' : 'Spirit'
      article.px-spec(class={"px-spec--flip": i % 2 === 1, "px-spec--out": !available})
        .px-spec-media
          img.px-spec-bottle(src="/images/v3-bottle-new.png", onerror="this.src='/images/bottle.webp'", alt=`${s.name} bottle`)
        .px-spec-body
          p.px-spec-cat= cat
          h3.px-spec-name= s.name
          p.px-spec-specs
            if available
              | #{s.volume} · #{s.abv} · NZ$#{s.price}
            else
              | #{s.volume} · #{s.abv} · Coming soon
          p.px-spec-desc= s.description
          p.px-spec-serve= s.serve
          .px-actions
            if available
              a.px-btn(href="/order") Order
            else
              a.px-link(href="#club") Get notified →
            button.px-link.px-more(type="button", onclick=`document.getElementById('card-${s.id}').click()`) Read more →

    //- Experimental batch = one numbered row in the index
    mixin batchRow(s, i)
      - var available = s.status === 'available'
      - var no = String(i + 1).padStart(2, '0')
      .px-batch(class={"px-batch--out": !available})
        .px-batch-no BATCH #{no}
        .px-batch-main
          h3.px-batch-name= s.name
          p.px-batch-specs
            if available
              | #{s.volume} · #{s.abv} · NZ$#{s.price}
            else
              | #{s.volume} · #{s.abv} · Coming soon
          p.px-batch-desc= s.description
        .px-batch-action
          if available
            a.px-btn(href="/order") Order
          else
            span.px-soon Coming soon
            a.px-link(href="#club") Get notified →
          button.px-link.px-more(type="button", onclick=`document.getElementById('card-${s.id}').click()`) Read more →

    //- Hidden pool of standard spirit cards — each "Read more" button clicks
    //- its matching card to open the shared landing-page modal. The card is
    //- what the modal clones into its left column, plus the story payload.
    mixin modalCard(s)
      .v5-card(id=`card-${s.id}`, data-spirit=s.id, data-status=s.status)
        img.v5-card-bottle(src="/images/v3-bottle-new.png", onerror="this.src='/images/bottle.webp'", alt=`${s.name} bottle`)
        h3= s.name
        p.v5-card-meta #{s.volume} · #{s.abv}
        template.v5-card-data
          .v5-modal-story-content
            h2= s.name
            if s.story
              each para in s.story
                p= para
          .v5-modal-aside-content
            if s.bestServed && s.bestServed.length
              p.v5-kicker Best served
              ul.v5-served
                each item in s.bestServed
                  li= item
            if s.photo
              figure.v5-detail-photo
                img(src=`/images/v5-${s.id}.jpg`, alt=s.photoAlt, onerror="this.style.display='none'; this.parentNode.classList.add('is-empty')")
                figcaption Photo coming soon

    //- ---- page ------------------------------------------------------------
    main.px
      section.px-hero
        .wrap
          p.px-eyebrow Mangaroa Valley · Aotearoa
          h1.px-hero-title Everything we make begins on #[em the same still.]
          p.px-hero-lead Fermented and distilled by hand in small batches. The vodka stops at step three, the gin runs the full four, and the limoncello borrows both. Three we make always — and a shelf of limited batches that grows when a good idea turns up.

      section.px-specs#range
        .wrap
          .px-section-head
            h2 Signature Range
            span.px-section-count Always three
          each bottle, i in bottles
            +specimen(bottle, i)

      if experimentalBatches && experimentalBatches.length
        section.px-index#experimental
          .wrap
            .px-section-head
              h2 Experimental Range
              span.px-section-count #{experimentalBatches.length} #{experimentalBatches.length === 1 ? 'batch' : 'batches'}
            .px-batches
              each item, i in experimentalBatches
                +batchRow(item, i)

    //- offscreen source cards for the modal
    .px-modal-cards(hidden)
      each s in bottles
        +modalCard(s)
      if experimentalBatches && experimentalBatches.length
        each s in experimentalBatches
          +modalCard(s)

    include _footer
    include _spiritmodal
    include _navscroll
    include _agegate
