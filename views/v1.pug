doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Longstream Distillery — V1 Wild Botanical
    link(rel="icon", type="image/png", href="/images/logo.png")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="crossorigin")
    link(href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600&family=Manrope:wght@400;600;700&display=swap", rel="stylesheet")
    link(rel="stylesheet", href="/styles/v1.css")
  body
    header.v1-header
      .wrap
        a.v1-brand(href="/v1")
          img(src="/images/logo.png", alt="Longstream Distillery")
          span Longstream
        nav.v1-nav
          a(href="#story") Our Story
          a(href="#range") The Range
          a(href="#contact") Visit
          a.v1-btn(href="/order") Order Online

    main
      //- HERO
      section.v1-hero
        .wrap
          div
            p.v1-eyebrow Mangaroa Valley · Upper Hutt
            h1 Small-batch spirits with #[em Aotearoa] soul
            p A family distillery on the banks of Te Awa Kairangi — copper-distilled gin, limoncello and vodka, made by hand in tiny batches.
            .v1-hero-actions
              a.v1-btn(href="#range") Explore the range
              a.v1-link-ghost(href="#story") Our story →
          figure.v1-hero-figure
            img(src="/images/v1-hero.png", onerror="this.src='/images/house.jpg'", alt="Longstream distillery in the Mangaroa Valley")
            .v1-hero-stamp Est.#[br]Mangaroa#[br]Valley

      //- STORY
      section.v1-story#story
        .wrap
          .v1-section-head
            p.v1-kicker From kitchen bench to cellar door
            h2 A hobby that took over the family garage
          .v1-story-grid
            div
              p Longstream Distillery began as a kitchen-bench experiment chasing the perfect evening tipple. Recycled bottles and a small still made the first few bottles — and it quickly grew from a hobby into an addiction that took over our family garage.
              p Friends, family and neighbours were the first guinea pigs. As word spread, requests for more bottles became a regular thing and the experimental flavours found a following.
              p Of the many batches made, our Blonde Dry Gin and Louie Limoncello have been perfected and are now available. Every bottle is still made with absolute care — each step taken to ensure the best possible taste.
            aside.v1-story-aside
              h3 The Longstream way
              ul
                li Copper pot distilled in small batches
                li Pure Te Awa Kairangi valley water
                li Local botanicals, including kawakawa
                li Hand-bottled, labelled and numbered

      //- RANGE
      section.v1-range#range
        .wrap
          .v1-section-head
            p.v1-kicker Now pouring
            h2 The signature range
          .v1-cards
            each bottle in bottles
              article.v1-card(class={"v1-card--out": !bottle.available})
                if !bottle.available
                  span.v1-badge Resting
                img(src=bottle.image || "/images/bottle.png", alt=`${bottle.name} bottle`)
                h3= bottle.name
                p= bottle.description
                p.v1-card-meta #{bottle.volume} · #{bottle.abv} ABV#{bottle.available ? ' · NZ$' + bottle.price : ''}

      //- CONTACT
      section.v1-contact#contact
        .wrap
          .v1-contact-grid
            div
              p.v1-kicker Come say hello
              h2 Book a tasting at the cellar door
              p Private tastings, event supply, or a simple question — we'd love to hear from you.
            .v1-contact-card
              p
                strong Email
                br
                a(href="mailto:enquiries@longstream.nz") enquiries@longstream.nz
              p
                strong Cellar door
                br
                | Mangaroa, Upper Hutt, Wellington Region

    footer.v1-footer
      .wrap
        p.v1-foot-brand Longstream Distillery
        p Crafted with pride in Mangaroa, Upper Hutt.
        p © #{new Date().getFullYear()} Longstream Distillery. All rights reserved.

    include _vswitch
