doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Longstream Distillery — V2 Riverstone
    link(rel="icon", type="image/png", href="/images/logo.png")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="crossorigin")
    link(href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500;600&display=swap", rel="stylesheet")
    link(rel="stylesheet", href="/styles/v2.css")
  body
    header.v2-header
      .wrap
        a.v2-brand(href="/v2")
          img(src="/images/logo.png", alt="Longstream Distillery")
          span Longstream
        nav.v2-nav
          a(href="#story") Story
          a(href="#range") Range
          a(href="#contact") Contact
          a.v2-btn(href="/order") Order

    main
      //- HERO (full-bleed photo)
      section.v2-hero
        .v2-hero-bg(style="background-image:url('/images/v2-hero.webp'), url('/images/destill.webp')")
        .wrap
          p.v2-hero-eyebrow Distilled in the Mangaroa Valley
          h1 Quietly crafted, in tiny batches
          p Premium gin, limoncello and vodka — distilled by hand beside Te Awa Kairangi and bottled in numbers small enough to count.
          .v2-hero-actions
            a.v2-btn-solid(href="#range") Shop the range
            a.v2-btn-line(href="#story") Our story

      .v2-strip
        span Copper distilled
        span Valley water
        span Local botanicals
        span Hand numbered

      //- STORY
      section.v2-story#story
        .wrap
          .v2-story-figure
            img(src="/images/v2-story.webp", onerror="this.src='/images/house.webp'", alt="The distillery")
          div
            p.v2-kicker The Longstream story
            h2 From a kitchen bench to the cellar door
            p Longstream began as a kitchen-bench experiment chasing the perfect evening tipple — recycled bottles, a small still, and a lot of patience. It grew from a hobby into something that took over the family garage.
            p Friends and neighbours were our first tasters. As word spread, our Blonde Dry Gin and Louie Limoncello were perfected, and every bottle is still made by hand with care at every step.
            .v2-stats
              .v2-stat
                .n 3
                .l Spirits
              .v2-stat
                .n 100%
                .l Hand bottled
              .v2-stat
                .n 1
                .l Valley

      //- RANGE
      section.v2-range#range
        .wrap
          .v2-range-head
            div
              p.v2-kicker Now pouring
              h2 The range
            p.lead A focused line-up of small-batch favourites, available for nationwide delivery.
          .v2-cards
            each bottle in bottles
              article.v2-card(class={"v2-card-out": !bottle.available})
                .v2-card-top
                  if !bottle.available
                    span.v2-tag Resting
                  img(src=bottle.image || "/images/bottle.webp", alt=`${bottle.name} bottle`)
                .v2-card-body
                  h3= bottle.name
                  p= bottle.description
                  .v2-card-meta
                    span #{bottle.volume} · #{bottle.abv}
                    if bottle.available
                      span.v2-price NZ$#{bottle.price}
                    else
                      span Sold out

      //- EXPERIMENTAL BATCHES
      section.v2-experimental#experimental
        .wrap
          .v2-range-head
            div
              p.v2-kicker Strictly limited
              h2 Experimental batches
            p.lead One-off distillations from the back of the shed. When they're gone, they're gone.
          .v2-exp-grid
            each batch in experimentalBatches
              article.v2-exp-card
                .v2-exp-head
                  h3= batch.name
                  span.v2-exp-pill #{batch.left}/#{batch.total} left
                p.v2-exp-blurb= batch.blurb
                .v2-exp-bar
                  span(style=`width:${Math.round(batch.left / batch.total * 100)}%`)
                .v2-exp-meta
                  span #{batch.volume} · #{batch.abv}
                  span.v2-price NZ$#{batch.price}

      //- CLUB
      section.v2-club#club
        .wrap
          div
            p.v2-kicker Members only
            h2 Join the Longstream Club
            p Be first to taste experimental batches, unlock members-only releases and get invitations to cellar-door tastings.
          form.v2-club-form(action="#" method="post")
            input(type="email" name="email" placeholder="you@example.com" required aria-label="Email address")
            button(type="submit") Join the club

      //- CONTACT
      section.v2-contact#contact
        .wrap
          div
            p.v2-kicker Visit us
            h2 Book a tasting at the cellar door
            p Private tastings, event supply, or corporate gifting — get in touch and we'll tailor something special.
          .v2-contact-info
            .row
              span Email
              a(href="mailto:enquiries@longstream.nz") enquiries@longstream.nz
            .row
              span Cellar door
              | Mangaroa, Upper Hutt, Wellington Region

    footer.v2-footer
      .wrap
        div
          .v2-foot-brand Longstream Distillery
          p Crafted with pride in Mangaroa, Upper Hutt.
        .v2-footer-news
          strong Stay in the loop
          p Be first to hear when new batches are released.
          form(action="#", method="post")
            input(type="email", placeholder="Your email", required)
            button(type="submit") Join
        .v2-foot-copy © #{new Date().getFullYear()} Longstream Distillery. All rights reserved.

    script.
      (function () {
        var strip = document.querySelector('.v2-strip');
        if (!strip) return;
        var items = Array.prototype.slice.call(strip.querySelectorAll('span'));
        var mq = window.matchMedia('(max-width: 600px)');

        function update() {
          items.forEach(function (el) { el.style.display = ''; });
          if (!mq.matches) return; // only trim on the single-row mobile layout
          var cs = getComputedStyle(strip);
          var avail = strip.clientWidth - (parseFloat(cs.paddingLeft) || 0) - (parseFloat(cs.paddingRight) || 0);
          var gap = parseFloat(cs.columnGap || cs.gap) || 0;
          var used = 0;
          var hiding = false;
          items.forEach(function (el) {
            var need = used + (used > 0 ? gap : 0) + el.offsetWidth;
            if (hiding || need > avail) {
              el.style.display = 'none';
              hiding = true;
            } else {
              used = need;
            }
          });
        }

        update();
        window.addEventListener('resize', update);
        if (mq.addEventListener) mq.addEventListener('change', update);
      })();

    include _vswitch
