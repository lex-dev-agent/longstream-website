doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Longstream Distillery — V3 Midnight Still
    link(rel="icon", type="image/png", href="/images/logo-white.png")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="crossorigin")
    link(href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400;500&display=swap", rel="stylesheet")
    link(rel="stylesheet", href="/styles/v3.css")
  body
    header.v3-header
      .wrap
        a.v3-brand(href="/v3")
          img(src="/images/logo-white.png", alt="Longstream Distillery")
          span Longstream
        nav.v3-nav
          a(href="#story") Our Story
          a(href="#range") The Range
          a(href="#contact") Visit
          a.v3-btn(href="/order") Order

    main
      //- HERO (spotlit bottle)
      section.v3-hero
        .v3-hero-glow
        img.v3-hero-bottle(src="/images/v3-bottle.webp", onerror="this.src='/images/bottle.webp'", alt="Longstream bottle")
        .wrap
          p.v3-hero-eyebrow Mangaroa Valley · Est. small batch
          h1 Spirits born of #[span.gold patience]
          p Copper-distilled gin, limoncello and vodka — made by hand in batches small enough to number, beside the waters of Te Awa Kairangi.
          .v3-hero-actions
            a.v3-btn-solid(href="#range") Discover the range
            a.v3-btn-ghost(href="#story") Our story

      //- STORY
      section.v3-story#story
        .wrap
          .v3-story-figure
            img(src="/images/v3-still.webp", onerror="this.src='/images/destill.webp'", alt="The copper still")
          div
            .v3-rule
            p.v3-kicker The Longstream story
            h2 A craft perfected after dark
            p Longstream began as a kitchen-bench experiment chasing the perfect evening tipple — recycled bottles and a small still that soon took over the family garage.
            p Friends and neighbours were the first to taste. As demand grew, our Blonde Dry Gin and Louie Limoncello were perfected, each bottle still made by hand with care at every step.
            p.v3-pull "Every bottle is made with absolute care — each step taken to ensure the best possible taste."

      //- RANGE
      section.v3-range#range
        .wrap
          .v3-range-head
            .v3-rule.center
            p.v3-kicker Now pouring
            h2 The signature range
            p A focused collection of small-batch spirits, available for nationwide delivery.
          .v3-cards
            each bottle in bottles
              article.v3-card(class={"v3-card-out": !bottle.available})
                if !bottle.available
                  span.v3-badge Resting
                img(src=bottle.image || "/images/bottle.webp", alt=`${bottle.name} bottle`)
                h3= bottle.name
                p= bottle.description
                p.v3-card-meta #{bottle.volume} · #{bottle.abv}#{bottle.available ? ' · NZ$' + bottle.price : ' · Sold out'}

      //- CONTACT
      section.v3-contact#contact
        .wrap
          .v3-rule.center
          p.v3-kicker Visit us
          h2 Book a tasting at the cellar door
          p.lead Private tastings, event supply, or corporate gifting — we'd love to hear from you.
          .v3-contact-cards
            .v3-contact-tile
              span Email
              a(href="mailto:enquiries@longstream.nz") enquiries@longstream.nz
            .v3-contact-tile
              span Cellar door
              | Mangaroa, Upper Hutt, Wellington Region

    footer.v3-footer
      .wrap
        .v3-foot-brand Longstream Distillery
        p Crafted with pride in Mangaroa, Upper Hutt.
        p © #{new Date().getFullYear()} Longstream Distillery. All rights reserved.

    include _vswitch
