doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Longstream Distillery — V4 (Pre-launch)
    link(rel="icon", type="image/png", href="/images/logo-white.png")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="crossorigin")
    link(href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400;500&display=swap", rel="stylesheet")
    link(rel="stylesheet", href="/styles/v4.css")
    script(src="https://www.google.com/recaptcha/api.js", async, defer)

  body
    header.v4-header
      .wrap
        a.v4-brand(href="/v4")
          img(src="/images/logo-white.png", alt="Longstream Distillery")
          span Longstream
        nav.v4-nav
          a(href="#story") Our Story
          a(href="#range") The Range
          a(href="#club") The Club
          a.v4-btn(href="#club") Notify Me

    main
      //- HERO (outline bottle behind the headline)
      section.v4-hero
        //- Pre-launch notice — pinned to the top of the hero
        .v4-notice
          .wrap
            span.v4-notice-tag Opening soon
            | We're not open for business just yet — join the Longstream Club below to be first to know when our spirits go on sale.
        .v4-hero-glow
        img.v4-hero-bottle(src="/images/v3-bottle.webp", onerror="this.src='/images/bottle.webp'", alt="Longstream bottle")
        .wrap
          p.v4-hero-eyebrow Mangaroa Valley Small Batch Spirits
          h1 Spirits born of #[span.gold patience]
          p Three-step distilled gin, limoncello and vodka — made from scratch in small batches and inspired by local history, from the waters of the Te Awa Kairangi aquifer in Mangaroa Valley, adjacent to Upper Hutt in provincial Wellington, New Zealand.
          .v4-hero-actions
            a.v4-btn-solid(href="#range") Discover the range
            a.v4-btn-ghost(href="#club") Join the Club

      //- STORY
      section.v4-story#story
        .wrap
          .v4-story-figure
            img(src="/images/v3-still.webp", onerror="this.src='/images/destill.webp'", alt="The copper still")
          div
            .v4-rule
            p.v4-kicker The Longstream story
            h2 A craft perfected after dark
            p Longstream began as a garage experiment in 2020 chasing the perfect evening tipple — recycled bottles and a small still soon took over the six-car family garage.
            p Friends, colleagues and neighbours were the first to taste and critique. As demand grew, our #[strong Blonde Dry Gin] and #[strong Louie Limoncello] were perfected, with care at every step.
            p Each batch is still hand produced from a three-step process. Alcohol is fermented on site, followed by a reflux vodka distillation, filtered through carbon, and then a pot distillation with the botanicals.
            p.v4-pull "Every bottle is made with absolute care — each step taken to ensure the best possible taste."

      //- RANGE
      section.v4-range#range
        .wrap
          .v4-range-head
            .v4-rule.center
            p.v4-kicker The range
            h2 The signature range
            p A focused collection of small-batch spirits. Not on sale yet — join the club to hear when they launch.
          .v4-cards
            each bottle in bottles
              article.v4-card(class={"v4-card-out": bottle.status !== 'available'})
                if bottle.status === 'soldout'
                  span.v4-badge Sold out
                else if bottle.status === 'coming-soon'
                  span.v4-badge Coming soon
                img.v4-card-bottle(src="/images/v3-bottle.webp", onerror="this.src='/images/bottle.webp'", alt=`${bottle.name} bottle`)
                h3= bottle.name
                p= bottle.description
                if bottle.serve
                  p.v4-card-serve= bottle.serve
                p.v4-card-meta
                  | #{bottle.volume} · #{bottle.abv}
                  if bottle.status === 'available'
                    |  · NZ$#{bottle.price}
                  else if bottle.status === 'soldout'
                    |  · Sold out
                  else if bottle.status === 'coming-soon'
                    |  · Coming soon

      //- LIMITED / EXPERIMENTAL BATCHES
      section.v4-experimental#experimental
        .wrap
          .v4-range-head
            .v4-rule.center
            p.v4-kicker Strictly limited
            h2 Experimental batches
            p One-off distillations from the back of the shed. Club members get first pour when these release.
          .v4-cards
            each batch in experimentalBatches
              article.v4-card(class={"v4-card-out": batch.status !== 'available'})
                if batch.status === 'soldout'
                  span.v4-badge Sold out
                else if batch.status === 'coming-soon'
                  span.v4-badge Coming soon
                img.v4-card-bottle(src="/images/v3-bottle.webp", onerror="this.src='/images/bottle.webp'", alt=`${batch.name} bottle`)
                h3= batch.name
                p= batch.description
                if batch.serve
                  p.v4-card-serve= batch.serve
                p.v4-card-meta
                  | #{batch.volume} · #{batch.abv}
                  if batch.status === 'available'
                    |  · NZ$#{batch.price}
                  else if batch.status === 'coming-soon'
                    |  · Coming soon

      //- CLUB (updates only — no tastings at this stage)
      section.v4-club#club
        .wrap
          .v4-rule.center
          p.v4-kicker Members only
          h2 Join the Longstream Club
          p.lead We're not open for business just yet. Join the club to get updates and be first to know when our spirits go on sale.
          if clubStatus === 'ok'
            p.v4-club-msg.ok Thanks — you're on the list. We'll be in touch when we launch.
          else if clubStatus === 'err'
            p.v4-club-msg.err Sorry, we couldn't add you. Please check your email and the verification, then try again.
          form.v4-club-form#v4-club-form(action="/v4/club", method="post")
            //- Honeypot: hidden from humans, catches naive bots
            .v4-hp(aria-hidden="true")
              label(for="company") Company
              input(type="text", id="company", name="company", tabindex="-1", autocomplete="off")
            .v4-club-row
              input(type="email", name="email", placeholder="you@example.com", required, aria-label="Email address")
              //- Invisible reCAPTCHA: the challenge runs on click, then onClubSubmit posts the form
              button.v4-btn-solid.g-recaptcha(type="submit", data-sitekey=recaptchaSiteKey, data-callback="onClubSubmit", data-size="invisible") Join
            //- Badge is hidden via CSS, so we show the required reCAPTCHA branding here instead
            p.v4-recaptcha-note
              | This site is protected by reCAPTCHA and the Google&nbsp;
              a(href="https://policies.google.com/privacy", target="_blank", rel="noopener") Privacy Policy
              |  and&nbsp;
              a(href="https://policies.google.com/terms", target="_blank", rel="noopener") Terms of Service
              |  apply.

    footer.v4-footer
      .wrap
        .v4-foot-brand Longstream Distillery
        p Crafted with pride in Mangaroa, Upper Hutt.
        p.v4-foot-warn Please enjoy responsibly. Not for sale to persons under 18.
        p © #{new Date().getFullYear()} Longstream Distillery. All rights reserved.

    include _navscroll
    include _agegate
    include _vswitch

    script.
      // Invisible reCAPTCHA callback — fires after the (usually invisible) check passes
      function onClubSubmit(token) {
        var form = document.getElementById('v4-club-form');
        if (form) form.submit();
      }
