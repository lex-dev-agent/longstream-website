doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Longstream Distillery — V5 (Pre-launch)
    link(rel="icon", type="image/png", href="/images/logo-white.png")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="crossorigin")
    link(href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400;500&display=swap", rel="stylesheet")
    link(rel="stylesheet", href="/styles/v5.css")
    script(src="https://www.google.com/recaptcha/api.js", async, defer)

  body
    //- Spirit card — opens the standardised modal on click. Carries a hidden
    //- payload (story + best served) the modal clones into its middle/right columns.
    mixin spiritCard(s)
      a.v5-card(href="#", role="button", data-spirit=s.id, data-status=s.status, class={"v5-card-out": s.status !== 'available'})
        if s.status === 'soldout'
          span.v5-badge Sold out
        else if s.status === 'coming-soon'
          span.v5-badge Coming soon
        img.v5-card-bottle(src="/images/v3-bottle.webp", onerror="this.src='/images/bottle.webp'", alt=`${s.name} bottle`)
        h3= s.name
        p= s.description
        if s.serve
          p.v5-card-serve= s.serve
        .v5-card-foot
          p.v5-card-meta
            | #{s.volume} · #{s.abv}
            if s.status === 'available'
              |  · NZ$#{s.price}
            else if s.status === 'soldout'
              |  · Sold out
            else if s.status === 'coming-soon'
              |  · Coming soon
        template.v5-card-data
          .v5-modal-story-content
            h2= s.name
            if s.story
              each para in s.story
                p= para
          .v5-modal-aside-content
            if s.bestServed && s.bestServed.length
              p.v5-kicker Best served
              ul.v5-served
                each item in s.bestServed
                  li= item
            if s.photo
              figure.v5-detail-photo
                img(src=`/images/v5-${s.id}.jpg`, alt=s.photoAlt, onerror="this.style.display='none'; this.parentNode.classList.add('is-empty')")
                figcaption Photo coming soon

    header.v5-header
      .wrap
        a.v5-brand(href="/v5")
          img(src="/images/logo-white.png", alt="Longstream Distillery")
          span Longstream
        nav.v5-nav
          a(href="#story") Our Story
          a(href="#range") The Range
          a(href="#club") The Club
          a.v5-btn(href="#club") Notify Me

    main
      //- HERO
      section.v5-hero
        //- Pre-launch notice — pinned to the top of the hero
        .v5-notice
          .wrap
            span.v5-notice-tag Opening soon
            | We're not open for business just yet — join the Longstream Club below to be first to know when our spirits go on sale.
        .v5-hero-glow
        img.v5-hero-bottle(src="/images/v3-bottle.webp", onerror="this.src='/images/bottle.webp'", alt="Longstream bottle")
        .wrap
          p.v5-hero-eyebrow Mangaroa Valley Small Batch Spirits
          h1 Spirits born of #[span.gold patience]
          p Four-step distilled gin, limoncello and vodka — made from scratch in small batches and inspired by local history, from the waters of the Te Awa Kairangi, adjacent to the Mangaroa Valley in provincial Wellington, New Zealand.
          .v5-hero-actions
            a.v5-btn-solid(href="#range") Discover the range
            a.v5-btn-ghost(href="#club") Join the Club

      //- STORY
      section.v5-story#story
        .wrap
          .v5-story-figure
            img(src="/images/v3-still.webp", onerror="this.src='/images/destill.webp'", alt="The copper still")
          div
            .v5-rule
            p.v5-kicker The Longstream story
            h2 A craft seeking perfection
            p Longstream began as a garage experiment in 2020 chasing the perfect evening tipple — recycled bottles and a small still soon took over the six-car family garage.
            p Friends, colleagues and neighbours were the first to taste and critique. As demand grew, our #[strong Blonde Gin] and #[strong Louie's Limoncello] were perfected, with care at every step.
            p Each batch is still hand produced using a four-step process. Alcohol is fermented on site, followed by a reflux distillation to make vodka, which is carbon filtered and then a pot distillation with the botanicals.
            p.v5-pull "Every bottle is made with absolute care — each step taken to ensure the best possible taste."

      //- RANGE
      section.v5-range#range
        .wrap
          .v5-range-head
            .v5-rule.center
            p.v5-kicker The range
            h2 Signature Range
            p A focused collection of small-batch spirits. Not on sale yet — join the club to hear when they launch.
          .v5-cards
            each bottle in bottles
              +spiritCard(bottle)

      //- LIMITED / EXPERIMENTAL BATCHES
      section.v5-experimental#experimental
        .wrap
          .v5-range-head
            .v5-rule.center
            p.v5-kicker Strictly limited
            h2 Experimental Batches
            p One-off distillations from the back of the shed. Club members get first pour when these release.
          .v5-cards
            each batch in experimentalBatches
              +spiritCard(batch)

      //- CLUB (updates only — no tastings at this stage)
      section.v5-club#club
        .wrap
          .v5-rule.center
          p.v5-kicker Members only
          h2 Join the Longstream Club
          p.lead We're not open for business just yet. Join the club to get updates and be first to know when our spirits go on sale.
          if clubStatus === 'ok'
            p.v5-club-msg.ok Thanks — you're on the list. We'll be in touch when we launch.
          else if clubStatus === 'err'
            p.v5-club-msg.err Sorry, we couldn't add you. Please check your email and the verification, then try again.
          form.v5-club-form#v5-club-form(action="/v5/club", method="post")
            //- Honeypot: hidden from humans, catches naive bots
            .v5-hp(aria-hidden="true")
              label(for="company") Company
              input(type="text", id="company", name="company", tabindex="-1", autocomplete="off")
            .v5-club-row
              input(type="email", name="email", placeholder="you@example.com", required, aria-label="Email address")
              //- Invisible reCAPTCHA: the challenge runs on click, then onClubSubmit posts the form
              button.v5-btn-solid.g-recaptcha(type="submit", data-sitekey=recaptchaSiteKey, data-callback="onClubSubmit", data-size="invisible") Join
            //- Badge is hidden via CSS, so we show the required reCAPTCHA branding here instead
            p.v5-recaptcha-note
              | This site is protected by reCAPTCHA and the Google&nbsp;
              a(href="https://policies.google.com/privacy", target="_blank", rel="noopener") Privacy Policy
              |  and&nbsp;
              a(href="https://policies.google.com/terms", target="_blank", rel="noopener") Terms of Service
              |  apply.

    footer.v5-footer
      .wrap
        .v5-foot-brand Longstream Distillery
        p Crafted with pride in Mangaroa, Upper Hutt.
        p.v5-foot-warn Please enjoy responsibly. Not for sale to persons under 18.
        p © #{new Date().getFullYear()} Longstream Distillery. All rights reserved.

    //- Standardised spirit modal — left: card copy · middle: story · right: best served
    .v5-modal(id="v5-modal", hidden)
      .v5-modal-dialog(role="dialog", aria-modal="true", aria-label="Spirit details")
        button.v5-modal-close(type="button", data-close, aria-label="Close") ×
        .v5-modal-grid
          .v5-modal-left
            .v5-modal-card
            button.v5-modal-cart(type="button", disabled, title="Not yet on sale") Add to cart
          .v5-modal-story
          .v5-modal-aside

    include _navscroll
    include _agegate
    unless hideSwitch
      include _vswitch

    script.
      // Invisible reCAPTCHA callback — fires after the (usually invisible) check passes
      function onClubSubmit(token) {
        var form = document.getElementById('v5-club-form');
        if (form) form.submit();
      }
    script.
      (function () {
        var modal = document.getElementById('v5-modal');
        if (!modal) return;
        var left = modal.querySelector('.v5-modal-card');
        var mid = modal.querySelector('.v5-modal-story');
        var right = modal.querySelector('.v5-modal-aside');
        var cart = modal.querySelector('.v5-modal-cart');
        function open(card) {
          left.innerHTML = ''; mid.innerHTML = ''; right.innerHTML = '';
          // left column = a copy of the clicked card (minus the hidden payload + cue)
          var clone = card.cloneNode(true);
          var data = clone.querySelector('.v5-card-data'); if (data) data.remove();
          var more = clone.querySelector('.v5-card-more'); if (more) more.remove();
          clone.removeAttribute('data-spirit');
          clone.classList.add('v5-modal-cardclone');
          left.appendChild(clone);
          // middle = story, right = best served (cloned from the card's payload)
          var tpl = card.querySelector('.v5-card-data');
          if (tpl && tpl.content) {
            var frag = tpl.content.cloneNode(true);
            var story = frag.querySelector('.v5-modal-story-content');
            var aside = frag.querySelector('.v5-modal-aside-content');
            if (story) mid.appendChild(story);
            if (aside) right.appendChild(aside);
          }
          // cart button reflects the product state (it stays disabled either way)
          if (cart) {
            var status = card.getAttribute('data-status');
            cart.textContent = status === 'soldout' ? 'Sold out'
              : status === 'coming-soon' ? 'Coming soon'
              : 'Add to cart';
          }
          modal.hidden = false;
          document.body.style.overflow = 'hidden';
        }
        function close() {
          modal.hidden = true; document.body.style.overflow = '';
          left.innerHTML = ''; mid.innerHTML = ''; right.innerHTML = '';
        }
        document.querySelectorAll('.v5-card[data-spirit]').forEach(function (card) {
          card.addEventListener('click', function (e) { e.preventDefault(); open(card); });
        });
        modal.addEventListener('click', function (e) {
          if (e.target === modal || (e.target.closest && e.target.closest('[data-close]'))) close();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !modal.hidden) close();
        });
      })();
