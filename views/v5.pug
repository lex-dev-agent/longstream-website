doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Longstream Distillery
    //- Dark logo by default (shows on light tab bars); white logo in dark mode
    link(rel="icon", type="image/png", href="/images/logo.png")
    link(rel="icon", type="image/png", href="/images/logo-white.png", media="(prefers-color-scheme: dark)")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="crossorigin")
    link(href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400;500&display=swap", rel="stylesheet")
    link(rel="stylesheet", href="/styles/v5.css")

  body
    include _spiritcard
    include _nav

    main
      //- HERO
      section.v5-hero
        //- Pre-launch notice — pinned to the top of the hero
        .v5-notice
          .wrap
            span.v5-notice-tag Opening soon
            span.v5-notice-text  We're not open for business just yet — join the Longstream Club below to be first to know when our spirits go on sale.
        .v5-hero-glow
        img.v5-hero-bottle(src="/images/v3-bottle-new.png", onerror="this.src='/images/bottle.webp'", alt="Longstream bottle")
        .wrap
          p.v5-hero-eyebrow Mangaroa Valley Small Batch Spirits
          h1 Spirits born of #[span.gold passion]
          p Spirits made from scratch in small batches from the waters of Te Awa Kairangi and inspired by local history.
          .v5-hero-actions
            a.v5-btn-solid(href="#range") Discover the range
            a.v5-btn-ghost(href="#club") Join the Club

      //- STORY
      section.v5-story#story
        .wrap
          .v5-story-figure
            img(src="/images/v3-still.webp", onerror="this.src='/images/destill.webp'", alt="The copper still")
          div
            .v5-rule
            p.v5-kicker The Longstream story
            h2 Years seeking perfection
            p Longstream began as a garage experiment in 2018 chasing the perfect evening tipple — recycled bottles and a small still soon took over the six-car family garage in #[strong Mangaroa Valley].
            p Friends and neighbours were the first to taste and critique. As demand grew, our #[strong Classic Blonde Gin] and #[strong Louie’s Limoncello] were perfected, with care at every step.
            p Because it is a #[strong “labour of love”] there was no need to take short cuts such as using commercially sourced ethyl alcohol as its base. Longstream alcohol is #[strong fermented “on site”] using traditional processes. The distillation processes still use small batch stills.
            p Longstream uses an Automation process that allows #[strong exacting repeatability] and record keeping from Ferment through to bottling that enables instant review if the resulting product is not up to scratch.
            p.v5-pull "Every bottle is made with absolute care — each step taken to ensure the best possible taste."

      //- RANGE
      section.v5-range#range
        .wrap
          .v5-range-head
            .v5-rule.center
            p.v5-kicker The range
            h2 Signature Range
            p A focused collection of small-batch spirits.#[br] Not on sale yet — join the club to hear when they launch.
          .v5-cards
            each bottle in bottles
              +spiritCard(bottle)

      //- LIMITED / EXPERIMENTAL BATCHES
      section.v5-experimental#experimental
        .wrap
          .v5-range-head
            .v5-rule.center
            p.v5-kicker Limited batches
            h2 Experimental Range
            p Our club members are the first in line when released.
          .v5-cards
            each batch in experimentalBatches
              +spiritCard(batch)

    include _footer
    include _spiritmodal
    include _navscroll
    include _agegate
