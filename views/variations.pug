doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Longstream Distillery — Design Variations
    link(rel="icon", type="image/png", href="/images/logo.png")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="crossorigin")
    link(href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..600&family=Manrope:wght@400;600;700&display=swap", rel="stylesheet")
    style.
      * { box-sizing: border-box; }
      body { margin: 0; font-family: 'Manrope', system-ui, sans-serif; background: #14271d; color: #e9e6da; line-height: 1.6; }
      .wrap { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
      header { text-align: center; padding: 5rem 0 2rem; }
      header .kick { font-size: 0.78rem; letter-spacing: 0.3em; text-transform: uppercase; color: #c5a256; margin: 0 0 1rem; }
      header h1 { font-family: 'Fraunces', serif; font-weight: 600; font-size: clamp(2.2rem, 5vw, 3.4rem); margin: 0 0 1rem; }
      header p { color: #aeb6a8; max-width: 36rem; margin: 0 auto; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; padding: 2rem 0 5rem; }
      .opt { background: #1b3327; border: 1px solid rgba(197,162,86,0.25); border-radius: 8px; overflow: hidden; text-decoration: none; color: inherit; transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease; display: flex; flex-direction: column; }
      .opt:hover { transform: translateY(-6px); box-shadow: 0 24px 50px rgba(0,0,0,.4); border-color: #c5a256; }
      .swatch { height: 120px; display: flex; }
      .swatch span { flex: 1; }
      .opt-body { padding: 1.5rem 1.5rem 1.75rem; }
      .opt-body .num { font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: #c5a256; }
      .opt-body h2 { font-family: 'Fraunces', serif; font-size: 1.5rem; margin: 0.35rem 0 0.5rem; }
      .opt-body p { color: #aeb6a8; font-size: 0.92rem; margin: 0 0 1rem; }
      .opt-body .go { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700; color: #e9e6da; border-bottom: 2px solid #c5a256; display: inline-block; padding-bottom: 2px; }
      footer { text-align: center; padding: 2rem 0 4rem; color: #8a9486; font-size: 0.85rem; }
      footer a { color: #c5a256; }
  body
    .wrap
      header
        p.kick Choose a direction
        h1 Longstream — homepage concepts
        p Three distinct visual directions for the website. Open each, compare, and we'll lock in the one you like (you can mix elements too).
      .grid
        a.opt(href="/v1")
          .swatch
            span(style="background:#1f3d2f")
            span(style="background:#f3eee1")
            span(style="background:#bb5e3c")
            span(style="background:#c5a256")
          .opt-body
            .num Variation 1
            h2 Wild Botanical
            p Editorial heritage-craft. Forest green & cream, terracotta accents, big serif display, magazine-style layout.
            span.go View V1 →
        a.opt(href="/v2")
          .swatch
            span(style="background:#fbfaf7")
            span(style="background:#8d9b86")
            span(style="background:#5b6a55")
            span(style="background:#b06a3c")
          .opt-body
            .num Variation 2
            h2 Riverstone
            p Modern minimal & premium. Light, airy, sage/stone with copper, full-bleed photo hero, clean product grid.
            span.go View V2 →
        a.opt(href="/v3")
          .swatch
            span(style="background:#0e100d")
            span(style="background:#1b1f1a")
            span(style="background:#2c4a3a")
            span(style="background:#c9a85c")
          .opt-body
            .num Variation 3
            h2 Midnight Still
            p Dark, moody & high-end. Near-black with gold foil, spotlit bottle hero, dramatic shadows, luxury feel.
            span.go View V3 →
      footer
        p Current live site: #[a(href="/") longstream homepage] · Order page: #[a(href="/order") /order]
